apiVersion: v1
kind: Secret
metadata:
  name: axion-secrets
  namespace: axion-minikube
type: Opaque
stringData:
  # TODO: Replace these with actual local values or create the secret via kubectl
  # Use the same credentials as the Docker Compose deployment
  DATABASE_URL: "postgresql://postgres:your_password_here@host.minikube.internal:5432/axiondb"
  POSTGRES_USER: "postgres"
  POSTGRES_PASSWORD: "your_password_here"
  POSTGRES_DB: "axiondb"
  POSTGRES_HOST: "host.minikube.internal"
  POSTGRES_PORT: "5432"
